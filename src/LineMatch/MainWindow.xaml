<Window x:Class="LineMatch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LineMatch — поиск совпадений" Width="1020" Height="760" MinWidth="800" MinHeight="680" Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#E8EEF6"/><Setter Property="BorderBrush" Value="#CFD9E6"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#CFD9E6"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/></Style>
  </Window.Resources>
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="Поиск совпадений строк" FontSize="28" FontWeight="SemiBold" Foreground="#15263C"/><TextBlock Text="Точное сравнение строк в больших файлах" Foreground="#607188"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Эталонный файл" VerticalAlignment="Center"/><TextBox x:Name="SmallPath" Grid.Column="1"/><Button Grid.Column="2" Content="Выбрать" Click="BrowseSmall_Click" Margin="10,0,0,0"/><TextBlock Grid.Row="2" Text="Папка work" VerticalAlignment="Center"/><TextBox x:Name="WorkPath" Grid.Row="2" Grid.Column="1"/><Button Grid.Row="2" Grid.Column="2" Content="Выбрать" Click="BrowseWork_Click" Margin="10,0,0,0"/></Grid></Border>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16" Margin="0,12,0,0"><WrapPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="После обработки" Foreground="#607188"/><ComboBox x:Name="Disposition" Width="215"><ComboBoxItem Content="Оставить исходники" Tag="Keep" IsSelected="True"/><ComboBoxItem Content="Переместить в processed" Tag="Move"/><ComboBoxItem Content="Удалить безвозвратно" Tag="Delete"/></ComboBox></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="Потоков" Foreground="#607188"/><TextBox x:Name="Threads" Width="70" Text="4"/></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="Буфер, строк" Foreground="#607188"/><TextBox x:Name="ChunkSize" Width="90" Text="10000"/></StackPanel><StackPanel><TextBlock Text="Кодировка" Foreground="#607188"/><ComboBox x:Name="EncodingChoice" Width="130"><ComboBoxItem Content="UTF-8" IsSelected="True"/><ComboBoxItem Content="UTF-16 LE"/><ComboBoxItem Content="UTF-16 BE"/></ComboBox></StackPanel></WrapPanel></Border>
    <StackPanel Grid.Row="3" Margin="0,18,0,14"><StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="Начать поиск" Click="Start_Click" Background="#1766D3" Foreground="White"/><Button x:Name="PauseButton" Content="Пауза" Click="Pause_Click" IsEnabled="False"/><Button x:Name="StopButton" Content="Остановить" Click="Stop_Click" IsEnabled="False"/></StackPanel><TextBlock x:Name="Status" Text="Готово к запуску" Foreground="#607188" Margin="0,12,0,6"/><ProgressBar x:Name="Progress" Height="10" Maximum="100"/></StackPanel>
    <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><UniformGrid Columns="5" Margin="0,0,0,10"><StackPanel><TextBlock Text="Файлы"/><TextBlock x:Name="FilesCount" Text="0 / 0" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="Строки"/><TextBlock x:Name="LinesCount" Text="0" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="Совпадения"/><TextBlock x:Name="HitsCount" Text="0" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="Скорость"/><TextBlock x:Name="Speed" Text="0 строк/с" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="RAM"/><TextBlock x:Name="Memory" Text="0 МБ" FontSize="20"/></StackPanel></UniformGrid><DataGrid x:Name="MatchesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="180"/><DataGridTextColumn Header="Строка №" Binding="{Binding LineNumber}" Width="110"/><DataGridTextColumn Header="Совпадение" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
    <Expander Grid.Row="5" Header="Журнал" IsExpanded="False" Margin="0,12,0,0" FontWeight="SemiBold"><TextBox x:Name="LogBox" Height="110" Margin="0,8,0,0" FontWeight="Normal" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Expander>
  </Grid>
</Window>
